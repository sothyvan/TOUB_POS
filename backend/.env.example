# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Business-local offset used for report date ranges and hourly revenue buckets.
REPORT_TIMEZONE_OFFSET=+07:00

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=toub_pos

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
# Access JWTs stay only in browser memory and rotate through the HttpOnly refresh cookie.
JWT_ACCESS_EXPIRES_IN=15m
# Maximum login session, including cashier shift sessions.
REFRESH_SESSION_EXPIRES_HOURS=8
# Development defaults to lax. Cross-site production hosting requires none + HTTPS.
AUTH_COOKIE_SAME_SITE=lax

# ── Development Bootstrap Account ────────────────────────
# Used only when NODE_ENV is not production and the platform admin does not exist yet.
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=platform123
PLATFORM_ADMIN_ROLE=platform_admin

# ── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=change_this_to_a_random_secret
TELEGRAM_GROUP_CONNECTION_EXPIRY_MINUTES=10
# Durable paid-order kitchen delivery worker.
TELEGRAM_DISPATCH_WORKER_ENABLED=true
TELEGRAM_DISPATCH_INTERVAL_MS=2000
TELEGRAM_DISPATCH_BATCH_SIZE=10
TELEGRAM_DISPATCH_MAX_ATTEMPTS=5
TELEGRAM_DISPATCH_RETRY_BASE_MS=5000
TELEGRAM_DISPATCH_LOCK_TIMEOUT_MS=60000
TELEGRAM_API_TIMEOUT_MS=10000
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ── Product Images (ImageKit) ────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# ── KHQR Individual Payment ──────────────────────────────
# Disabled by default while TouB POS evaluates an approved merchant payment provider.
KHQR_ENABLED=false
BAKONG_ACCOUNT_ID=owner_or_stall_account@bakong
KHQR_MERCHANT_NAME=Toub POS
KHQR_MERCHANT_CITY=PHNOM PENH
KHQR_EXPIRATION_MINUTES=10

# ── Bakong Transaction Status Checking ───────────────────
# Testing/SIT: https://sit-api-bakong.nbc.org.kh
# Production:  https://api-bakong.nbc.gov.kh
BAKONG_OPEN_API_BASE_URL=https://sit-api-bakong.nbc.org.kh
BAKONG_OPEN_API_TOKEN=replace_with_bakong_open_api_token

# ── KHQR Background Status Checker ───────────────────────
# Has no effect unless KHQR_ENABLED=true.
KHQR_BACKGROUND_CHECK_ENABLED=false
KHQR_BACKGROUND_CHECK_INTERVAL_MS=5000
KHQR_BACKGROUND_CHECK_BATCH_SIZE=10
