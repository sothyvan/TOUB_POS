# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Business-local offset used for report date ranges and hourly revenue buckets.
REPORT_TIMEZONE_OFFSET=+07:00
# Readiness database probe timeout and maximum graceful shutdown duration.
READINESS_DATABASE_TIMEOUT_MS=2000
SHUTDOWN_GRACE_PERIOD_MS=15000

# Swagger is available by default only outside production. Production keeps it
# absent unless explicitly enabled and protected with separate Basic Auth credentials.
API_DOCS_ENABLED=true
# API_DOCS_USERNAME=docs_operator
# API_DOCS_PASSWORD=replace_with_a_long_random_docs_password

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=toub_pos
# Production requires exactly one trusted provider CA source. A relative path is
# resolved from the backend working directory. DB_SSL_CA also accepts a PEM
# value with literal \n separators for secret-only hosting platforms.
# DB_SSL_CA_PATH=./certs/provider-ca.pem
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Keep false normally. Set true only for one reviewed `npm run db:migrate:down`
# command after taking and verifying a database backup.
ALLOW_MIGRATION_ROLLBACK=false

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret
# Access JWTs stay only in browser memory and rotate through the HttpOnly refresh cookie.
JWT_ACCESS_EXPIRES_IN=15m
# Maximum login session, including cashier shift sessions.
REFRESH_SESSION_EXPIRES_HOURS=8
# Development defaults to lax. Cross-site production hosting requires none + HTTPS.
AUTH_COOKIE_SAME_SITE=lax

# ── Production Proxy + Shared Rate Limiting ──────────────
# Set this to the exact number of trusted reverse proxies between the client
# and Express. Use 0 only when clients connect directly to Node without a proxy.
# Common single-proxy deployments use 1; verify this with the hosting provider.
TRUST_PROXY_HOPS=0
# Required in production so every API instance shares authentication counters.
# Use rediss:// when the provider offers TLS. Keep credentials outside Git.
# RATE_LIMIT_REDIS_URL=rediss://default:password@redis.example.com:6379
# Separate environments sharing one Redis service must use different prefixes.
RATE_LIMIT_REDIS_PREFIX=toub-pos:development

# ── Development Bootstrap Account ────────────────────────
# Used only when NODE_ENV is not production and the platform admin does not exist yet.
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=platform123
PLATFORM_ADMIN_ROLE=platform_admin

# ── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=change_this_to_a_random_secret
TELEGRAM_GROUP_CONNECTION_EXPIRY_MINUTES=10
# Durable paid-order kitchen delivery worker.
TELEGRAM_DISPATCH_WORKER_ENABLED=true
TELEGRAM_DISPATCH_INTERVAL_MS=2000
TELEGRAM_DISPATCH_BATCH_SIZE=10
TELEGRAM_DISPATCH_MAX_ATTEMPTS=5
TELEGRAM_DISPATCH_RETRY_BASE_MS=5000
TELEGRAM_DISPATCH_LOCK_TIMEOUT_MS=60000
TELEGRAM_API_TIMEOUT_MS=10000
# Owner/Manager dashboard alert thresholds. Invalid or unsafe values fall back
# to the backend defaults (60 seconds pending/processing, 24-hour latency window).
TELEGRAM_MONITOR_PENDING_STALE_MS=60000
TELEGRAM_MONITOR_PROCESSING_STALE_MS=60000
TELEGRAM_MONITOR_LATENCY_WINDOW_HOURS=24
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ── Product Images (ImageKit) ────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# ── Historical KHQR Configuration ────────────────────────
# Must remain false. The vulnerable legacy SDK has been removed while TouB POS
# evaluates an approved merchant payment provider.
KHQR_ENABLED=false
# Reserved historical/future-provider settings. They do not enable payment.
BAKONG_ACCOUNT_ID=owner_or_stall_account@bakong
KHQR_MERCHANT_NAME=Toub POS
KHQR_MERCHANT_CITY=PHNOM PENH
KHQR_EXPIRATION_MINUTES=10

# ── Bakong Transaction Status Checking ───────────────────
# Testing/SIT: https://sit-api-bakong.nbc.org.kh
# Production:  https://api-bakong.nbc.gov.kh
BAKONG_OPEN_API_BASE_URL=https://sit-api-bakong.nbc.org.kh
BAKONG_OPEN_API_TOKEN=replace_with_bakong_open_api_token

# ── KHQR Background Status Checker ───────────────────────
# Has no effect unless KHQR_ENABLED=true.
KHQR_BACKGROUND_CHECK_ENABLED=false
KHQR_BACKGROUND_CHECK_INTERVAL_MS=5000
KHQR_BACKGROUND_CHECK_BATCH_SIZE=10

# ── Repository Backup Script ─────────────────────────────
# Used only by backup_database.py. Store the real value in GitHub Actions
# secrets or the ignored local .env; never commit it.
BACKUP_ENCRYPTION_PASSPHRASE=replace_with_a_long_random_backup_passphrase
