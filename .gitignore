# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Environment variables (never commit secrets) ──────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Build output ──────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS & editor artifacts ─────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ──────────────────────────────────────────────────
*.local

# Local browser verification artifacts
.playwright-cli/
output/playwright/
frontend/playwright-report/
frontend/test-results/

# Database backups contain operational data and credentials/hashes.
# Keep canonical SQL only under docs/database/ and backend migrations.
/backups/
*_backup_*.sql
*.sql.gz
*.sql.gpg
*.sql.gpg.sha256
*.dump
*.bak
*.backup

# Python cache generated by backup-policy tests
__pycache__/
*.py[cod]
