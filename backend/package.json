{
  "name": "toub-pos-backend",
  "version": "1.0.0",
  "description": "Toub POS — Express.js REST API backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon  src/server.js",
    "tunnel": "node src/scripts/dev/start-tunnel.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:bulk": "node src/scripts/seed-bulk-products.js",
    "seed:audit": "node src/scripts/seed-audit-logs.js",
    "migrate:telegram-cooks": "node src/scripts/migrations/add-telegram-cook-authorization.js",
    "test": "node --test tests/report-range.unit.test.js tests/khqr-suspension.unit.test.js tests/telegram-callback-authorization.unit.test.js",
    "test:credentials": "node --test tests/credential-model.live.test.js",
    "test:orders": "node --test tests/order-flow.live.test.js",
    "test:live": "npm run test:credentials && npm run test:orders",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.9.1",
    "bakong-khqr": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "node-fetch": "^3.3.2",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.9.0",
    "@ngrok/ngrok": "^1.7.0",
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.4"
  }
}
