VITE_API_BASE_URL=http://localhost:3000/api
# The production build derives its CSP API and Socket.IO origins from this URL.
# Use an absolute HTTPS API URL for cross-origin production hosting or /api when
# the frontend and backend share an origin.

# KHQR is opt-in while TouB POS evaluates an approved merchant payment provider.
VITE_KHQR_ENABLED=false
